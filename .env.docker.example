# Local Docker only — runtime env written into config.js at container start.
# AWS SPA deploy uses SSM + pnpm config:generate — see docs/DEPLOY.md.
# Copy to repo-root `.env` for `pnpm docker:run` / `docker compose up`.
#
# VITE_APP_ENV=local is for workstation / local Docker only.
# Deployed envs use VITE_APP_ENV=dev|staging|production (via SSM), never local.
# VITE_ENABLE_MOCKS=true is for local demo smoke only.

VITE_APP_ENV=local
VITE_APP_NAME=ui-platform demo
VITE_API_BASE_URL=/api
VITE_SENTRY_DSN=
VITE_ENABLE_MOCKS=true
