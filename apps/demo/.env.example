# Optional Vite fallbacks for local tooling/tests.
# Prefer apps/demo/public/config.js (and Docker runtime env) for app config.
# Workstation env name is local — not the deployed "dev" environment.
VITE_APP_ENV=local
VITE_APP_NAME=ui-platform demo
VITE_API_BASE_URL=/api
VITE_SENTRY_DSN=
VITE_ENABLE_MOCKS=true
